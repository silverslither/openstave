export const MAX_PLAYER_BYTES = 128 * 1024 * 1024;
export const MAX_CACHE_SIZE_BYTES = 512 * 1024 * 1024;

export const TCP_ADDRESS = "localhost";
export const TCP_PORT = 61124;
export const AUTH_WAIT_MS = 1000;

export const HTTP_PORT = 61125;
export const MAX_BODY_SIZE_BYTES = 4 * 1024;
export const MAX_ACTIVE_RACES = 10;

export const CRASH_TIMEOUT_MS = 10000;
export const VACUUM_INTERVAL_MS = 10000;

const MINUTES = 60 * 1000;
export const TIMEOUTS: Record<string, number> = {
    "default": 30 * MINUTES,
    "smb1_any%": 15 * MINUTES,
    "smb1_warpless": 45 * MINUTES,
    "smb2j_any%": 20 * MINUTES,
    "smb2j_warpless": 50 * MINUTES,
    "smb3_any%nww": 25 * MINUTES,
};


import assert from "node:assert";

assert(Number.isInteger(MAX_PLAYER_BYTES) && MAX_PLAYER_BYTES > 0 && MAX_PLAYER_BYTES <= 0xffffffff);
assert(Number.isInteger(MAX_CACHE_SIZE_BYTES) && MAX_CACHE_SIZE_BYTES > 0 && MAX_CACHE_SIZE_BYTES <= Number.MAX_SAFE_INTEGER);
assert(Number.isInteger(MAX_BODY_SIZE_BYTES) && MAX_BODY_SIZE_BYTES > 0 && MAX_BODY_SIZE_BYTES <= Number.MAX_SAFE_INTEGER);
assert(Number.isInteger(MAX_ACTIVE_RACES) && MAX_ACTIVE_RACES > 0 && MAX_ACTIVE_RACES <= Number.MAX_SAFE_INTEGER);
assert(Number.isInteger(TCP_PORT) && TCP_PORT > 0 && TCP_PORT <= 0xffff);
assert(Number.isInteger(HTTP_PORT) && HTTP_PORT > 0 && HTTP_PORT <= 0xffff);
assert(Number.isInteger(AUTH_WAIT_MS) && AUTH_WAIT_MS > 0 && AUTH_WAIT_MS <= 0x7fffffff);
assert(Number.isInteger(CRASH_TIMEOUT_MS) && CRASH_TIMEOUT_MS > 0 && CRASH_TIMEOUT_MS <= 0x7fffffff);
assert(Number.isInteger(VACUUM_INTERVAL_MS) && VACUUM_INTERVAL_MS > 0 && VACUUM_INTERVAL_MS <= 0x7fffffff);

assert(TIMEOUTS.default != null);
for (const timeout of Object.values(TIMEOUTS))
    assert(Number.isInteger(timeout) && timeout > 0 && timeout <= 24 * 60 * MINUTES);
